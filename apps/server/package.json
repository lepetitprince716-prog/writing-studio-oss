  },
  "dependencies": {
    "@writing-studio/contract": "workspace:*",
    "@fastify/websocket": "^11.0.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.1",
    "chokidar": "^5.0.0",
    "diff-match-patch": "^1.0.5",
    "fast-glob": "^3.3.3",
    "fastify": "^5.2.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.10.0",
    "tsx": "4.23.1",
    "typescript": "^5.7.0",
    "@types/ws": "^8.5.13"
  }
}
