{
  "name": "@writing-studio/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "create-project": "node --import tsx src/cli/create-project.ts",
    "validate-config": "node --import tsx src/cli/validate-config.ts",
    "typecheck": "tsc --noEmit",
